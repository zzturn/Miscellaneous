#!name=RQ Mod
#!desc=将 RQ 的响应转换为 VIP 状态（Surge）
#!requirement=CORE_VERSION>=20

[Body Rewrite]
http-response ^https:\/\/www\.rq\.run\/user(?:\/record\/info\?id=\d+.*|$) const\s+VIP\s*=\s*([^;]+); const VIP=1;

[Script]
rq-api-vip = type=http-response,pattern=^https:\/\/api\.rq\.run\/Api\/\w+\/\w+(?:\?.*)?$,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/zzturn/Miscellaneous/master/Surge/rq.js

[MITM]
hostname = %APPEND% *.rq.run
